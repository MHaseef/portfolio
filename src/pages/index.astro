---
export const prerender = false;
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { ThreeGlobeCanvas } from '../components/ThreeGlobeCanvas';
import { SmoothScroll } from '../components/SmoothScroll';
import { MainPortfolioApp } from '../components/MainPortfolioApp';

const rawProfile = await getCollection('profile');
const bioData = rawProfile.find(entry => entry.id === 'bio')?.data;
const contactData = rawProfile.find(entry => entry.id === 'contact')?.data;

const skillsEntry = rawProfile.find(entry => entry.id === 'skills')?.data;
const skillsData = skillsEntry?.skills || undefined;

const expEntry = rawProfile.find(entry => entry.id === 'experience')?.data;
const experienceItems = expEntry?.experience || [];

const projEntry = rawProfile.find(entry => entry.id === 'projects')?.data;
const projectItems = projEntry?.projects || [];

const blogEntry = rawProfile.find(entry => entry.id === 'blog')?.data;
const blogItems = blogEntry?.blog || [];


---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Muhammad Haseef — WebGIS & Spatial AI Portfolio</title>
    <meta
      name="description"
      content="Portfolio of Muhammad Haseef — GIS developer and spatial data analyst building WebGIS platforms, automating spatial workflows, and applying Spatial AI."
    />
    <!-- OpenGraph Meta Tags -->
    <meta property="og:title" content="Muhammad Haseef — WebGIS & Spatial AI Portfolio" />
    <meta
      property="og:description"
      content="GIS developer and spatial data analyst building WebGIS platforms and Spatial AI systems."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <ThreeGlobeCanvas client:only="react" />
    <SmoothScroll client:load>
      <MainPortfolioApp
        client:load
        experienceItems={experienceItems}
        projectItems={projectItems}
        blogItems={blogItems}
        bioData={bioData}
        skillsData={skillsData}
        contactData={contactData}
      />
    </SmoothScroll>
  </body>
</html>
