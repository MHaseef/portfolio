---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, category, readTime, excerpt } = post.data;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Muhammad Haseef</title>
    <meta name="description" content={excerpt} />

    <!-- SEO OpenGraph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={excerpt} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style>
      body {
        margin: 0;
        background: #FFFFFF;
        color: #16181C;
        font-family: 'Source Sans 3', sans-serif;
      }
      a {
        color: #1B6FA8;
      }
      a:hover {
        color: #135183;
      }
      .article-body {
        color: #3E4349;
        font-size: 17px;
        line-height: 1.8;
      }
      .article-body h2 {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        font-size: 23px;
        margin: 40px 0 16px;
        color: #16181C;
      }
      .article-body code {
        font-family: 'JetBrains Mono', monospace;
        background: #F0EEE9;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
      }
      .article-body pre {
        background: #F7F6F3;
        border: 1px solid #E6E4DF;
        border-radius: 10px;
        padding: 20px;
        overflow-x: auto;
      }
      .article-body pre code {
        background: none;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <header
      style="position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:20px 56px;background:#FFFFFF;border-bottom:1px solid #E6E4DF;"
    >
      <div style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:20px;color:#16181C;">
        Muhammad Haseef
      </div>
      <a
        href="/#blogs"
        style="text-decoration:none;color:#5C6167;font-size:14px;font-weight:600;"
      >
        ← Back to main portfolio
      </a>
    </header>

    <article style="max-width:760px;margin:0 auto;padding:64px 32px 120px;">
      <div style="display:flex;gap:14px;align-items:center;margin-bottom:20px;">
        <span
          style="font-size:11px;font-weight:700;letter-spacing:0.5px;color:#1B6FA8;background:#E3F1FB;padding:5px 12px;border-radius:20px;"
        >
          {category}
        </span>
        <span style="font-size:13px;color:#8A8F94;">
          {date} · {readTime} read
        </span>
      </div>

      <h1
        style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:clamp(28px,5vw,42px);line-height:1.25;margin:0 0 24px;color:#16181C;"
      >
        {title}
      </h1>

      <div
        style="width:100%;height:320px;border-radius:12px;background:linear-gradient(135deg, #0F2036 0%, #1B6FA8 100%);display:flex;align-items:center;justify-content:center;color:#FFFFFF;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:20px;margin-bottom:36px;"
      >
        {title}
      </div>

      <div class="article-body">
        <Content />
      </div>

      <p
        style="color:#8A8F94;font-size:15px;line-height:1.8;margin:40px 0 0;border-top:1px solid #E6E4DF;padding-top:24px;"
      >
        — Muhammad Haseef, Geoinformatics Engineer
      </p>

      <a
        href="/#blogs"
        style="display:inline-block;margin-top:40px;color:#5C6167;text-decoration:none;font-size:13px;font-weight:600;"
      >
        ← Back to main portfolio
      </a>
    </article>
  </body>
</html>
